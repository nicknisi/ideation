node_modules/
*.log
.env

# Local-only Claude/impeccable state
.claude/settings.local.json
.impeccable/
PRODUCT.md
DESIGN.md
# The impeccable skill installs a full copy of itself into all three of these.
# This repo publishes a plugin to a marketplace: a stray `git add -A` would
# vendor ~50 files of someone else's skill into it. Ignored, not deleted.
.claude/skills/
.github/skills/
.github/hooks/
test-fixtures/**/out/
# Ideation working artifacts stay local — but the learning store is meant to be
# committed and shared, so it is explicitly un-ignored. (`docs/ideation/*` not
# `docs/ideation/`: git cannot re-include a file under an ignored directory.)
docs/ideation/*
!docs/ideation/learnings.md

# The root package.json declares scripts and a packageManager and nothing else —
# zero dependencies — so a root lockfile locks nothing (`importers: { .: {} }`).
# CI and the docs both use `node --run test`, which never writes one, but
# `pnpm test` regenerates it on every run, so ignoring it is what stops it
# reappearing in `git status` forever. Leading slash on purpose:
# `site/pnpm-lock.yaml` is real and tracked, and a bare pattern would swallow it.
/pnpm-lock.yaml

# Astro site build output and cache (the site is built by Cloudflare from source)
site/dist/
site/.astro/
site/.wrangler/

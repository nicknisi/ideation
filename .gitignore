node_modules/
*.log
.env

# Local-only Claude/impeccable state
.claude/settings.local.json
.impeccable/
PRODUCT.md
# The impeccable skill installs a full copy of itself into all three of these.
# This repo publishes a plugin to a marketplace: a stray `git add -A` would
# vendor ~50 files of someone else's skill into it. Ignored, not deleted.
.claude/skills/
.github/skills/
.github/hooks/
test-fixtures/**/out/
# Ideation working artifacts stay local — but the learning store is meant to be
# committed and shared, so it is explicitly un-ignored. (`docs/ideation/*` not
# `docs/ideation/`: git cannot re-include a file under an ignored directory.)
docs/ideation/*
!docs/ideation/learnings.md
# The ux-dejank dogfood run is published history — a real run, kept unedited —
# linked from the README's Example section and the site walkthrough.
!docs/ideation/ux-dejank/

# The root package.json declares no dependencies — the pi tools the skills call
# (pi-subagents, pi-dynamic-workflows, rpiv-ask-user-question) are user-level
# installs, deliberately not bundled (see references/harness-compat.md § 3).
# package-lock.json stays committed as the stub `npm install` expects. A stray
# `pnpm install` at the root would still emit a lockfile; ignore it. Leading
# slash on purpose: `site/pnpm-lock.yaml` is real and tracked, and a bare
# pattern would swallow it.
/pnpm-lock.yaml

# Astro site build output and cache (the site is built by Cloudflare from source)
site/dist/
site/.astro/
site/.wrangler/

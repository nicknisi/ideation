---
import Site from '../layouts/Site.astro';
import Stamp from '../components/Stamp.astro';
---

<Site title="Not here — ideation" description="That page does not exist on ideation.engineering.">
  <main class="mx-auto grid min-h-[60vh] max-w-[52rem] place-items-center px-5 py-16">
    <div class="grid max-w-[46ch] gap-5">
      <Stamp label="Not found" sub="404" tone="faint" press class="justify-self-start" />
      <h1 class="text-[clamp(1.9rem,5vw,2.6rem)]">No contract for this page</h1>
      <p class="text-muted">
        Nothing was agreed at this address, so nothing was built here. These pages exist:
      </p>
      <p class="flex flex-wrap gap-x-5 gap-y-2 font-sans">
        <a class="link" href="/">Overview</a>
        <a class="link" href="/walkthrough/pi/">Pi walkthrough</a>
        <a class="link" href="/walkthrough/">Claude Code walkthrough</a>
        <a class="link" href="/guide/">Guide</a>
      </p>
    </div>
  </main>
</Site>

---
import Guide from '../layouts/Guide.astro';
---

<Guide
  title="Not here — ideation"
  description="That page does not exist on ideation.engineering."
>
  <main class="mx-auto grid min-h-[70vh] max-w-[52rem] place-items-center px-5">
    <div class="max-w-[46ch]">
      <p class="label-mono text-accent">
        <span class="mr-2 inline-block h-px w-6 translate-y-[-4px] bg-accent"></span>404
      </p>
      <h1 class="mt-3 text-[clamp(1.9rem,5vw,2.6rem)]">Nothing planted here</h1>
      <p class="mt-4 text-muted">
        That page does not exist. There are only two, which makes this a fairly
        impressive miss.
      </p>
      <p class="mt-6">
        <a
          class="text-accent underline decoration-line-strong underline-offset-2 hover:decoration-accent"
          href="/">the illustrated walkthrough</a
        >
        <span class="mx-2 text-faint">·</span>
        <a
          class="text-accent underline decoration-line-strong underline-offset-2 hover:decoration-accent"
          href="/guide/">the command reference</a
        >
      </p>
    </div>
  </main>
</Guide>

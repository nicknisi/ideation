---
import Site from '../layouts/Site.astro';
import InstallBlock from '../components/InstallBlock.astro';
import ContractPlate from '../components/ContractPlate.astro';
import Stamp from '../components/Stamp.astro';
import { readInstall } from '../lib/install';
import { readGates } from '../lib/gates';
import { joinCommands } from '../data/commands';
import { joinPi } from '../data/pi';
import { walkthrough } from '../lib/native';

// Every mechanical fact below is read from the plugin at build time.
const install = readInstall();
const gates = readGates();
const pi = joinPi();
const wt = await walkthrough();
const fp = wt.fingerprint.slice(0, 8).toUpperCase();
const planning = joinCommands().filter(c => c.slug !== 'change');

const PI_STEPS = [
  {
    cmd: '/ideation',
    title: 'Say what should change',
    body: 'The agent reads your code and asks only what the code cannot answer. Then it prepares a compact brief: before and after, what must hold, and the checks that prove it.',
  },
  {
    cmd: 'the contract',
    title: 'Read it in your browser',
    body: 'It opens on its own: a dependency map, every check, the exact paths and commands it may use. Comment on anything. Comments are feedback, never permission.',
  },
  {
    cmd: '/ideation approve',
    title: 'Approve once',
    body: 'One short confirmation in Pi binds those paths and commands (Approve in Pi on the page brings it up too). There is no time or token limit; work starts right away in an isolated worktree on its own branch.',
  },
  {
    cmd: 'walk away',
    title: 'Let it work',
    body: 'Each piece is planned just in time, built, and independently reviewed. The Pi widget and the same contract page update as evidence arrives.',
  },
  {
    cmd: '/ideation accept',
    title: 'Decide at review',
    body: 'Ready for review is not accepted. Read the evidence, make the human judgments, and accept. Merging the branch stays yours.',
  },
];

const STAGES = [
  {
    title: 'Brainstorm',
    body: 'A position on whether the idea is worth building at all. Conversation only — it writes no files, enforced by its tool list.',
    stops: 'it concludes no — and writes nothing either way.',
  },
  {
    title: 'Interview',
    body: `${gates.length} gates, each backed by an artifact rather than a confident sentence: the problem, the goals, the success criteria, the scope, and consistency with the code you already have.`,
    stops: `a gate cannot be evidenced. It keeps asking; generation starts at ${gates.length} of ${gates.length}.`,
  },
  {
    title: 'Critique',
    body: 'Four read-only critics — scope creep, over-engineering, hidden dependencies, unfalsifiable criteria — file findings at three severities.',
    stops: 'a blocker is filed. The plan goes back, and the interview can reopen on that gate.',
  },
  {
    title: 'Contract',
    body: 'One document to decide on, plus the specs that will be executed against it and a routing verdict: walk away, watch it run, or run it yourself.',
    stops: 'always. Nothing proceeds until you approve, and the tier you pick bounds the specs.',
  },
  {
    title: 'Execute',
    body: 'Phases build in waves on an isolation branch, each reviewed before it commits, each commit naming its spec so a resumed run skips it.',
    stops: 'five ways — including a reviewer that returns no verdict, or a commit that cannot name its files.',
  },
  {
    title: 'Harvest',
    body: 'At most three candidate lessons from the run, deduped against what is already recorded. Accept, edit or dismiss each one.',
    stops: 'you dismiss them. A learning store nobody curates is only a log.',
  },
  {
    title: 'Next run',
    body: 'The next interview opens by naming the lesson it is applying, as its first question. learnings.md is committed with the repo: the team’s memory, not one machine’s.',
    stops: 'never. The only stage that cannot stop you — it points back at the interview.',
  },
];

const REFUSALS = [
  {
    title: 'No blind commits',
    body: 'There is no <code class="code">git add -A</code> anywhere in it. Every commit names the files it wrote; one that cannot refuses instead.',
  },
  {
    title: 'No question cap',
    body: 'The interview runs as long as the evidence takes. In practice it is short, because every question arrives with a recommended answer.',
  },
  {
    title: 'No silent edits',
    body: 'Critics are read-only by construction. Every fold-in lands in the decision log, where you can see the reasoning and reverse it.',
  },
];

const EITHER_WAY = [
  {
    title: 'Approval is the only permission',
    body: 'Nothing is built before you approve a contract. Comments, questions and silence never count as a yes.',
  },
  {
    title: 'Evidence, not confidence',
    body: 'Plans need artifacts, and checks are commands that must exit 0. A judgment only a person can make waits for a person.',
  },
  {
    title: 'It stops at review',
    body: 'Work lands as local commits on its own branch. Neither path pushes, merges or deploys.',
  },
  {
    title: 'Files you own',
    body: 'Contracts, specs and receipts are files in docs/ideation/, yours to commit or not. There is no service and no account.',
  },
];

const h2 = 'text-[clamp(1.75rem,4.2vw,2.5rem)] tracking-[-0.015em]';
const h3 = 'text-[1.25rem]';
const lede = 'max-w-[62ch] text-[1.0625rem] text-muted';
---

<Site
  title="ideation — agree on the contract, then walk away"
  description="ideation turns what you want into a contract you approve before any code is written. Then your coding agent builds it on its own branch, proves it with checks, and stops for your review. In Pi or Claude Code."
>
  <main class="mx-auto max-w-[76rem] px-[clamp(1.25rem,4vw,2.5rem)]">
    <!-- ══════════ Hero ══════════ -->
    <section class="grid items-center gap-10 pt-16 pb-12 min-[960px]:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] max-[700px]:pt-10">
      <div>
        <h1 class="text-[clamp(2.4rem,6vw,4.25rem)] leading-[1.02] tracking-[-0.03em]">
          <span class="block">Agree on the contract.</span> <span class="block text-accent">Then walk away.</span>
        </h1>
        <p class="mt-6 max-w-[56ch] text-[1.1875rem] leading-[1.6] text-muted">
          ideation turns what you want into a contract you can read and approve before a line of code
          is written. Then your coding agent builds it on its own branch, proves it with checks, and
          stops for your review.
        </p>
        <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-sans text-[0.9375rem]">
          <a class="link" href="#tracks">Choose your agent ↓</a>
          <a class="link" href="/guide/">Read the guide</a>
        </p>
      </div>

      <div class="relative -ml-8 h-[19rem] max-[959px]:hidden" aria-hidden="true">
        <Stamp label="Draft" sub={`Not approved · ${fp}`} tone="faint" press class="absolute top-2 left-4 origin-top-left" style="animation-delay:.15s; rotate:-5deg; scale:1.3" />
        <Stamp label="Approved" sub={`Rev 2 · ${fp}`} press class="absolute top-[6.6rem] left-[5.5rem] origin-top-left" style="animation-delay:.55s; rotate:2deg; scale:1.3" />
        <Stamp label="Ready for review" sub={`Rev 2 · ${fp}`} press class="absolute top-[12.4rem] left-8 origin-top-left" style="animation-delay:.95s; rotate:6deg; scale:1.3" />
      </div>
    </section>

    <!-- ══════════ Two tracks ══════════ -->
    <section id="tracks" aria-label="Two ways in" class="scroll-mt-20">
      <script is:inline>
        // Choose the panel before it paints: #pi / #claude-code, else the last
        // choice, else Pi. Without JavaScript both panels simply stack.
        (function () {
          var h = location.hash.slice(1), t = null;
          try { t = localStorage.getItem('ideation-track'); } catch (e) {}
          document.documentElement.dataset.track = h === 'pi' || h === 'claude-code' ? h : t === 'claude-code' ? t : 'pi';
        })();
      </script>
      <p class="mb-3 font-sans text-[0.9375rem] text-muted">Two ways in, with equal standing. Pick the one that fits your agent and your idea.</p>
      <div role="tablist" aria-label="Choose a track" class="strip grid-cols-2 overflow-hidden">
        <button type="button" role="tab" id="tab-pi" aria-controls="pi" data-track="pi" class="track-tab">
          <span class="track-label">In Pi</span>
          <span class="track-title">Agree once, walk away.</span>
          <span class="track-body">A compact change contract, one approval, then a live page that stamps itself ready for review.</span>
          <span class="track-best">Best when the change is clear enough to state as before and after.</span>
        </button>
        <button type="button" role="tab" id="tab-claude-code" aria-controls="claude-code" data-track="claude-code" class="track-tab">
          <span class="track-label">In Claude Code</span>
          <span class="track-title">Plan it in depth.</span>
          <span class="track-body">An evidence-gated interview, four critics, a contract and specs, then one reviewed commit per phase.</span>
          <span class="track-best">Best when the idea is still messy, or big enough to need phases.</span>
        </button>
      </div>

      <!-- ── Pi ─────────────────────────────────────────────────────── -->
      <div id="pi" role="tabpanel" aria-labelledby="tab-pi" data-track-panel="pi" class="track-panel scroll-mt-20 pt-12">
        <h2 class={h2}><span class="mr-3 font-sans text-[0.9375rem] font-semibold tracking-normal text-accent">In Pi</span>Agree once, walk away.</h2>

        <div class="mt-8 grid items-start gap-10 min-[1000px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
          <figure class="sheet m-0" data-settle>
            <div class="sheet-bar"><span>ideation in Pi · 21 seconds · sound on</span></div>
            <video
              class="block aspect-video w-full bg-paper"
              controls
              playsinline
              preload="none"
              poster="/media/ideation-launch-poster.jpg"
              aria-describedby="video-note"
            >
              <source src="/media/ideation-launch.mp4" type="video/mp4" />
              <a href="/media/ideation-launch.mp4">Download the video (MP4)</a>
            </video>
            <figcaption id="video-note" class="border-t border-line px-4 py-2.5 font-sans text-[0.8125rem] text-muted">
              The widget frames are the extension’s real output; the change is fictional. No narration.
            </figcaption>
          </figure>

          <ol class="m-0 grid list-none gap-0 p-0">
            {
              PI_STEPS.map((s, i) => (
                <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3 border-t border-line py-4 first:border-t-0 first:pt-0" data-settle>
                  <span class="font-mono text-[0.8125rem] leading-[1.9] text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="flex flex-wrap items-baseline gap-x-2.5 text-[1.125rem]">
                      {s.title}
                      <code class="font-mono text-[0.78rem] font-normal text-muted">{s.cmd}</code>
                    </h3>
                    <p class="mt-1 text-[0.96875rem] text-muted">{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="mt-14 grid items-center gap-8 min-[900px]:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
          <div>
            <h3 class={h3}>One page, from draft to receipt</h3>
            <p class="mt-2 max-w-[52ch] text-muted">
              The contract you approve becomes the run’s live page, then its record: the same link, and
              the same comments. The stamp only ever reports recorded state.
            </p>
            <p class="mt-4 font-sans text-[0.9375rem]">
              <a class="link" href="/walkthrough/pi/">See every page in the walkthrough →</a>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-x-8 gap-y-6 py-2">
            <Stamp label="Draft" sub={`Not approved · ${fp}`} tone="faint" press />
            <Stamp label="Approved" sub={`Rev 2 · ${fp}`} press style="animation-delay:.2s" />
            <Stamp label="Ready for review" sub={`Rev 2 · ${fp}`} press style="animation-delay:.4s" />
            <Stamp label="Accepted" sub={`Rev 2 · ${fp}`} tone="go" press style="animation-delay:.6s" />
          </div>
        </div>

        <div class="strip mt-14 min-[761px]:grid-cols-2" data-settle>
          <div>
            <h3 class={h3}>Commands</h3>
            <dl class="mt-3 grid gap-2 text-[0.9375rem]">
              <div><dt class="inline font-mono text-[0.84rem] text-accent">/ideation</dt> <dd class="inline text-muted">— the guided menu for whatever is in flight</dd></div>
              {
                pi.subcommands.filter(s => ['plan', 'approve', 'pause', 'accept'].includes(s.name)).map(s => (
                  <div>
                    <dt class="inline font-mono text-[0.84rem] text-accent">{s.name}{s.args && ` ${s.args}`}</dt>{' '}
                    <dd class="inline text-muted">— {s.short}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 font-sans text-[0.875rem]"><a class="link" href="/guide/#pi">All {pi.subcommands.length} subcommands →</a></p>
          </div>
          <div>
            <h3 class={h3}>Where it lands</h3>
            <ul class="mt-3 grid list-none gap-2 p-0 text-[0.9375rem] text-muted">
              <li>Commits on <code class="code">ideation/&lt;run-id&gt;</code>, in its own worktree. Merging stays yours.</li>
              <li>The brief, contract and receipt in <code class="code">docs/ideation/&lt;change&gt;/</code>: commit them, or don’t.</li>
              <li>Uncommitted work never blocks it. Start from your last commit, or include your changes; it never stashes or edits them.</li>
            </ul>
          </div>
          <div class="strip-row grid items-center gap-x-8 gap-y-3 min-[900px]:grid-cols-[minmax(0,1fr)_minmax(0,36rem)]">
            <div>
              <h3 class={h3}>Install</h3>
              <p class="mt-1.5 text-[0.9375rem] text-muted">Pi 0.87.1 or newer. The second line is optional and makes the contract a live page. Then run <code class="code">/ideation</code>.</p>
            </div>
            <InstallBlock label="pi" lines={install.pi} />
          </div>
        </div>

        <p class="mt-8 font-sans text-[1rem]">
          <a class="link" href="/walkthrough/pi/">Walk through one change, from <code class="code">/ideation</code> to accept →</a>
        </p>
      </div>

      <!-- ── Claude Code ────────────────────────────────────────────── -->
      <div id="claude-code" role="tabpanel" aria-labelledby="tab-claude-code" data-track-panel="claude-code" class="track-panel scroll-mt-20 pt-12">
        <h2 class={h2}><span class="mr-3 font-sans text-[0.9375rem] font-semibold tracking-normal text-accent">In Claude Code</span>Plan it in depth.</h2>

        <div class="mt-8 grid items-start gap-10 min-[1000px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
          <figure class="sheet m-0" data-settle>
            <div class="sheet-bar"><span>docs/ideation/bookmark-garden/contract.html</span></div>
            <ContractPlate />
            <figcaption class="border-t border-line px-4 py-2.5 font-sans text-[0.8125rem] text-muted">
              The contract, generated at the end of the interview and before any execution.
            </figcaption>
          </figure>
          <div>
            <p class="text-[1.0625rem]">
              The interview keeps going until every claim carries evidence. Four adversarial critics read
              the plan. You get one document to decide on, with specs to execute against it, and then
              your agent builds it: one reviewed commit per phase, on its own branch.
            </p>
            <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-line pt-5">
              <div><dt class="font-sans text-[0.8125rem] text-muted">evidence gates</dt><dd class="m-0 text-[2rem] leading-none font-bold text-accent">{gates.length}</dd></div>
              <div><dt class="font-sans text-[0.8125rem] text-muted">read-only critics</dt><dd class="m-0 text-[2rem] leading-none font-bold text-accent">4</dd></div>
              <div><dt class="font-sans text-[0.8125rem] text-muted">stages that can stop it</dt><dd class="m-0 text-[2rem] leading-none font-bold text-accent">{STAGES.length - 1}</dd></div>
            </dl>
            <p class="mt-5 text-[0.9375rem] text-muted">
              It also runs in Pi: start it with <code class="code">/skill:ideation</code>.
            </p>
          </div>
        </div>

        <h3 class:list={[h3, 'mt-14']}>The seven stages</h3>
        <p class="mt-2 max-w-[62ch] text-muted">Each has a defined output and defined grounds for stopping. Stopping is not error handling; it is the mechanism.</p>
        <ol class="mt-6 grid list-none gap-0 border-t border-line-strong p-0">
          {
            STAGES.map((s, i) => (
              <li class="grid grid-cols-[2.5rem_minmax(0,12rem)_minmax(0,1fr)] gap-x-5 gap-y-1 border-b border-line py-4 max-[760px]:grid-cols-[2.5rem_minmax(0,1fr)]" data-settle>
                <span class="font-mono text-[0.8125rem] leading-[1.9] text-accent">{String(i + 1).padStart(2, '0')}</span>
                <h4 class="m-0 text-[1.125rem] font-bold">{s.title}</h4>
                <div class="max-[760px]:col-start-2">
                  <p class="text-[0.96875rem]">{s.body}</p>
                  <p class="mt-1 text-[0.9375rem] text-muted">
                    <span class="mr-2 font-sans text-[0.8125rem] font-semibold text-caution">Stops when</span>
                    {s.stops}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-14 flex flex-wrap items-end justify-between gap-6">
          <div>
            <h3 class={h3}>What it refuses</h3>
            <p class="mt-2 max-w-[60ch] text-muted">Structural, not advisory: enforced by tool lists and commit rules, not good intentions.</p>
          </div>
          <Stamp label="Refused" tone="accent" press class="mr-4" style="scale:1.15" />
        </div>
        <div class="strip mt-5 min-[761px]:grid-cols-3" data-settle>
          {
            REFUSALS.map(r => (
              <div>
                <h4 class="m-0 text-[1.0625rem] font-bold">{r.title}</h4>
                <p class="mt-1.5 text-[0.9375rem] text-muted" set:html={r.body} />
              </div>
            ))
          }
        </div>

        <div class="strip mt-14 min-[761px]:grid-cols-2" data-settle>
          <div>
            <h3 class={h3}>Commands</h3>
            <dl class="mt-3 grid gap-2 text-[0.9375rem]">
              {
                planning.map(c => (
                  <div>
                    <dt class="inline font-mono text-[0.84rem] text-accent">{c.command}</dt>{' '}
                    <dd class="inline text-muted">— {c.headline.replace(/\.$/, '')}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div>
            <h3 class={h3}>What it writes</h3>
            <pre class="mt-3 overflow-x-auto font-mono text-[0.78rem] leading-[1.85] text-muted">docs/ideation/
├── learnings.md
└── bookmark-garden/
    ├── contract.html
    ├── contract.md
    ├── contract-data.json
    ├── spec-phase-1.md …
    └── verify.mjs</pre>
            <p class="mt-2 font-sans text-[0.875rem] text-muted">Reviewable files, committed with the code.</p>
          </div>
          <div class="strip-row grid items-start gap-x-8 gap-y-3 min-[900px]:grid-cols-[minmax(0,1fr)_minmax(0,36rem)]">
            <div>
              <h3 class={h3}>Install</h3>
              <p class="mt-1.5 text-[0.9375rem] text-muted">Paste both lines together, then run <code class="code">/ideation</code> and describe the messy version of your idea.</p>
              <details class="mt-3 font-sans text-[0.875rem]">
                <summary class="cursor-pointer text-accent">Running it in Pi instead</summary>
                <p class="mt-2 text-muted">Install the plugin and the two tools the planning path calls, then run <code class="code">/skill:ideation</code>. Every command here works the same way, as <code class="code">/skill:&lt;name&gt;</code>.</p>
                <InstallBlock label="pi · planning path" lines={[install.pi[0], ...install.piPlanning]} class="mt-3" />
              </details>
            </div>
            <InstallBlock label="Claude Code" lines={install.claudeCode} />
          </div>
        </div>

        <p class="mt-8 font-sans text-[1rem]">
          <a class="link" href="/walkthrough/">Follow one idea through all seven stages →</a>
        </p>
      </div>
    </section>

    <!-- ══════════ Either way ══════════ -->
    <section class="rule-double mt-20 pt-10" aria-labelledby="either">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div>
          <h2 id="either" class={h2}>Either way</h2>
          <p class:list={[lede, 'mt-3']}>Two front doors, one set of promises.</p>
        </div>
        <Stamp label="No push · No merge · No deploy" tone="accent" press class="stamp-wrap mt-2 mr-2" />
      </div>
      <div class="strip mt-8 min-[761px]:grid-cols-4" data-settle>
        {
          EITHER_WAY.map(e => (
            <div>
              <h3 class="text-[1.0625rem]">{e.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] text-muted">{e.body}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <style>
    .track-tab {
      display: grid;
      gap: 0.3rem;
      align-content: start;
      text-align: left;
      cursor: pointer;
      background: var(--surface-1);
      color: var(--muted);
      font: inherit;
      border: 0;
      padding: 1.25rem 1.4rem 1.35rem !important;
      transition:
        background-color 0.15s,
        color 0.15s,
        box-shadow 0.18s var(--ease);
    }
    .track-tab:hover {
      color: var(--ink);
      background: var(--surface-2);
    }
    .track-label {
      font: 600 0.875rem/1.3 var(--font-sans);
      color: var(--accent);
    }
    .track-title {
      font-size: clamp(1.35rem, 3vw, 1.75rem);
      line-height: 1.15;
      font-weight: 700;
      color: var(--ink);
    }
    .track-body {
      font-size: 1rem;
    }
    .track-best {
      font: 0.875rem/1.5 var(--font-sans);
      margin-top: 0.25rem;
    }
    :global(html[data-track='pi']) #tab-pi,
    :global(html[data-track='claude-code']) #tab-claude-code {
      background: var(--surface-2);
      color: var(--ink);
      box-shadow: inset 0 4px 0 0 var(--accent);
    }
    :global(html[data-track='pi']) #claude-code,
    :global(html[data-track='claude-code']) #pi {
      display: none;
    }
    /* The long promise stamp wraps on phones instead of running off the page. */
    @media (max-width: 560px) {
      :global(.stamp-wrap) {
        white-space: normal;
        text-align: center;
      }
    }
    @media print {
      #claude-code,
      #pi {
        display: block !important;
      }
    }
  </style>

  <script is:inline>
    // Tabs: click or arrow keys switch; the choice is remembered and linkable.
    (function () {
      var tabs = [].slice.call(document.querySelectorAll('[role="tab"][data-track]'));
      if (!tabs.length) return;
      var root = document.documentElement;
      function select(track, focus) {
        root.dataset.track = track;
        tabs.forEach(function (t) {
          var on = t.dataset.track === track;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        try {
          localStorage.setItem('ideation-track', track);
        } catch (e) {}
      }
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () {
          select(t.dataset.track);
          history.replaceState(null, '', '#' + t.dataset.track);
        });
        t.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          var next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          select(next.dataset.track, true);
        });
      });
      select(root.dataset.track || 'pi');
      addEventListener('hashchange', function () {
        var h = location.hash.slice(1);
        if (h === 'pi' || h === 'claude-code') select(h);
      });
    })();
  </script>

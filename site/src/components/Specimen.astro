---
/**
 * Plate A — the planning walkthrough's specimen, drawn like a field guide's.
 *
 * Seven parts, inked one per step as the reader moves down the page: a bulb,
 * four stem segments with alternating leaves, a bud, and the bloom. Authored
 * fully drawn, so without motion (or without JavaScript) the plate is simply
 * finished. Purely decorative; the run is described in the prose beside it.
 */
---

<svg
  viewBox="0 0 120 200"
  width="100%"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  class="block text-accent"
  data-specimen
>
  <g data-part>
    <ellipse pathLength="1" cx="60" cy="186" rx="7" ry="5"></ellipse>
  </g>
  <g data-part>
    <path pathLength="1" d="M60 186V162"></path>
    <g transform="translate(60,170) rotate(-16) scale(0.5)" style="transform-origin: 0 0">
      <path pathLength="1" d="M0 0C10 -10 26 -8 30 0C26 8 10 10 0 0Z"></path>
    </g>
  </g>
  <g data-part>
    <path pathLength="1" d="M60 162V136"></path>
    <g transform="translate(60,146) rotate(16) scale(-0.55,0.55)" style="transform-origin: 0 0">
      <path pathLength="1" d="M0 0C10 -10 26 -8 30 0C26 8 10 10 0 0Z"></path>
    </g>
  </g>
  <g data-part>
    <path pathLength="1" d="M60 136V112"></path>
    <g transform="translate(60,120) rotate(-13) scale(0.68)" style="transform-origin: 0 0">
      <path pathLength="1" d="M0 0C10 -10 26 -8 30 0C26 8 10 10 0 0Z"></path>
    </g>
  </g>
  <g data-part>
    <path pathLength="1" d="M60 112V90"></path>
    <g transform="translate(60,98) rotate(13) scale(-0.68,0.68)" style="transform-origin: 0 0">
      <path pathLength="1" d="M0 0C10 -10 26 -8 30 0C26 8 10 10 0 0Z"></path>
    </g>
  </g>
  <g data-part>
    <path pathLength="1" d="M60 90V70"></path>
    <path pathLength="1" d="M60 70c-6-6-6-14 0-18 6 4 6 12 0 18Z"></path>
  </g>
  <g data-part>
    <circle pathLength="1" cx="60" cy="46" r="6"></circle>
    <path pathLength="1"
      d="M60 40c0-9 5-13 5-13s-1 13-5 13ZM66 46c9 0 13 5 13 5s-13-1-13-5ZM60 52c0 9-5 13-5 13s1-13 5-13ZM54 46c-9 0-13-5-13-5s13 1 13 5Z"
    ></path>
  </g>
</svg>

<style>
  /* Ink draws each part in as its step is reached. */
  :global([data-motion='on']) [data-specimen] :is(path, ellipse, circle) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease);
  }
  :global([data-motion='on']) [data-specimen] [data-part].is-drawn :is(path, ellipse, circle) {
    stroke-dashoffset: 0;
  }
</style>

---
export interface NavLink {
  href: string;
  label: string;
  /**
   * How hard the link fights for space as the bar narrows.
   *  - default: drops below 560px
   *  - 'optional': drops below 780px (a within-page jump, recoverable by scrolling)
   *  - 'always': never drops (the way off this site)
   */
  keep?: 'optional' | 'always';
}

interface Props {
  homeHref: string;
  links: NavLink[];
  /** Released plugin version, read from the manifest at build time. */
  version?: string;
}

const { homeHref, links, version } = Astro.props;

const priority = (keep: NavLink['keep']) =>
  keep === 'always' ? '' : keep === 'optional' ? 'max-[780px]:hidden' : 'max-[560px]:hidden';
---

<header
  class="sticky top-0 z-20 border-b border-line bg-canvas/88 backdrop-blur-[10px]"
>
  <div
    class="mx-auto flex h-[58px] max-w-[1340px] items-center gap-6 px-8 max-[560px]:px-6"
  >
    <a href={homeHref} class="flex items-center gap-3 text-ink hover:no-underline">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
        class="flex-none text-accent"
      >
        <path d="M12 22V11"></path>
        <path d="M12 11C12 7 9 4.5 5.5 4.5 5.5 8.5 8.5 11 12 11Z"></path>
        <path d="M12 14C12 10.5 14.8 8.2 18 8.2 18 11.9 15.2 14 12 14Z"></path>
      </svg>
      <span class="font-heading text-[19px] font-semibold tracking-[0.02em]">ideation</span>
      {
        version && (
          <span class="border border-line px-[5px] py-px font-mono text-[10.5px] text-neutral-700 max-[560px]:hidden">
            {version}
          </span>
        )
      }
    </a>

    <nav class="ml-auto flex items-center gap-6 text-[14px] max-[560px]:gap-4">
      {
        links.map(link => (
          <a
            href={link.href}
            class:list={['text-ink hover:text-accent-700 hover:no-underline', priority(link.keep)]}
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        class="grid size-[36px] flex-none place-items-center border border-line text-ink transition-colors hover:bg-ink/7"
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          class="dark:hidden"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
          ></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          class="hidden dark:block"
        >
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

---
import { readVersion } from '../lib/repo';

const version = readVersion();
const path = Astro.url.pathname.replace(/\/?$/, '/');

// The two tracks get equal billing, in the same order as the home page.
const LINKS = [
  { href: '/walkthrough/pi/', label: 'In Pi', match: (p: string) => p.startsWith('/walkthrough/pi/') },
  {
    href: '/walkthrough/',
    label: 'In Claude Code',
    match: (p: string) => p === '/walkthrough/',
  },
  { href: '/guide/', label: 'Guide', match: (p: string) => p.startsWith('/guide/') },
];
---

<header class="site-header sticky top-0 z-30 border-b border-line bg-paper">
  <div
    class="mx-auto flex max-w-[76rem] items-center gap-x-6 gap-y-1 px-[clamp(1.25rem,4vw,2.5rem)] py-3 max-[700px]:flex-wrap"
  >
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline" aria-label="ideation — home">
      <span class="diamond text-[0.95rem]" aria-hidden="true"></span>
      <span class="text-[1.3rem] leading-none font-bold tracking-[-0.02em]">ideation</span>
      <span
        class="rounded-(--radius-guide) border border-line px-1.5 py-px font-mono text-[0.6875rem] leading-[1.5] text-muted"
        title="Released plugin version">v{version}</span
      >
    </a>

    <nav
      aria-label="Site"
      class="ml-auto flex items-center gap-x-5 font-sans text-[0.875rem] max-[700px]:order-3 max-[700px]:ml-0 max-[700px]:w-full max-[700px]:gap-x-4 max-[700px]:overflow-x-auto max-[700px]:pb-1"
    >
      {
        LINKS.map(l => (
          <a
            href={l.href}
            aria-current={l.match(path) ? 'page' : undefined}
            class="nav-link whitespace-nowrap text-muted no-underline hover:text-ink"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="https://github.com/nicknisi/ideation"
        class="nav-link whitespace-nowrap text-muted no-underline hover:text-ink">GitHub ↗</a
      >
    </nav>

    <button
      type="button"
      class="theme-toggle grid h-8 w-8 flex-none place-items-center rounded-(--radius-guide) border border-line-strong bg-surface-2 text-muted transition-colors hover:text-accent max-[700px]:ml-auto"
      data-mode="auto"
      aria-label="Colour theme: follow system (click to change)"
    >
      <svg class="i-auto h-[18px] w-[18px]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="10" cy="10" r="6.5"></circle>
        <path d="M10 3.5 a6.5 6.5 0 0 0 0 13 Z" fill="currentColor" stroke="none"></path>
      </svg>
      <svg class="i-sun h-[18px] w-[18px]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="10" cy="10" r="3.6"></circle>
        <path d="M10 1.6 v2.2 M10 16.2 v2.2 M1.6 10 h2.2 M16.2 10 h2.2 M4.06 4.06 l1.56 1.56 M14.38 14.38 l1.56 1.56 M15.94 4.06 l-1.56 1.56 M5.62 14.38 l-1.56 1.56"></path>
      </svg>
      <svg class="i-moon h-[18px] w-[18px]" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M16.7 12.2 A7.5 7.5 0 1 1 7.8 3.3 a6 6 0 0 0 8.9 8.9 Z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .nav-link[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .theme-toggle .i-auto,
  .theme-toggle .i-sun,
  .theme-toggle .i-moon {
    display: none;
  }
  .theme-toggle[data-mode='auto'] .i-auto,
  .theme-toggle[data-mode='light'] .i-sun,
  .theme-toggle[data-mode='dark'] .i-moon {
    display: block;
  }
</style>

<script is:inline>
  // auto → light → dark, persisted, and mirrored to the embedded contracts
  // (same origin, their own storage key), which reload to pick it up.
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var root = document.documentElement;
    var modes = ['auto', 'light', 'dark'];
    var cur = root.dataset.theme || 'auto';
    function paint() {
      btn.dataset.mode = cur;
      var label = cur === 'auto' ? 'follow system' : cur;
      btn.setAttribute('aria-label', 'Colour theme: ' + label + ' (click to change)');
      btn.title = 'Colour theme: ' + label;
    }
    paint();
    btn.addEventListener('click', function () {
      cur = modes[(modes.indexOf(cur) + 1) % 3];
      try {
        if (cur === 'auto') {
          delete root.dataset.theme;
          localStorage.removeItem('ideation-theme');
          localStorage.removeItem('ideation-contract-theme');
        } else {
          root.dataset.theme = cur;
          localStorage.setItem('ideation-theme', cur);
          localStorage.setItem('ideation-contract-theme', cur);
        }
      } catch (e) {}
      paint();
      [].forEach.call(document.querySelectorAll('iframe[data-contract]'), function (f) {
        try {
          f.contentWindow.location.reload();
        } catch (e) {}
      });
    });
  })();
</script>

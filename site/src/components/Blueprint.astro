---
/**
 * A framed object with drafting registration marks at each corner.
 *
 * The marks sit 6px OUTSIDE the hairline border, so a Blueprint needs a
 * little breathing room and must not be placed inside an `overflow-hidden`
 * ancestor — the marks are the point, and clipping them reads as a bug.
 *
 * Any extra props are spread onto the rendered element, so this also serves
 * as the frame around a button.
 */
interface Props {
  /** Element to render as — `figure` for captioned plates, `div` otherwise. */
  as?: 'div' | 'figure' | 'aside' | 'button';
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = 'div', class: className = '', ...rest } = Astro.props;

// Each mark is an 11px box drawing one vertical and one horizontal hairline,
// offset so they cross like a printer's registration target.
const mark =
  'absolute size-[11px] text-ink/55 ' +
  "before:absolute before:top-0 before:left-[5px] before:h-full before:w-px before:bg-current before:content-[''] " +
  "after:absolute after:top-[5px] after:left-0 after:h-px after:w-full after:bg-current after:content-['']";
---

<Tag class:list={['relative border border-line', className]} {...rest}>
  <i class:list={[mark, '-top-[6px] -left-[6px]']} aria-hidden="true"></i>
  <i class:list={[mark, '-top-[6px] -right-[6px]']} aria-hidden="true"></i>
  <i class:list={[mark, '-bottom-[6px] -left-[6px]']} aria-hidden="true"></i>
  <i class:list={[mark, '-right-[6px] -bottom-[6px]']} aria-hidden="true"></i>
  <slot />
</Tag>

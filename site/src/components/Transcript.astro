---
/**
 * A framed transcript from a run: a bar naming the command and where it got
 * to, then the exchange itself.
 */
interface Props {
  /** What produced this output — the command or the stage. */
  source: string;
  /** Where the run stood when it printed this. */
  status: string;
  /** Gap between rows in the body; transcripts vary in density. */
  bodyClass?: string;
}

const { source, status, bodyClass = 'gap-4' } = Astro.props;
---

<figure class="sheet m-0" data-settle>
  <div class="sheet-bar">
    <span>{source}</span>
    <span class="flex-none">{status}</span>
  </div>
  <div class:list={['grid px-5 py-5 text-[0.96875rem] leading-[1.65] max-[560px]:px-4', bodyClass]}>
    <slot />
  </div>
</figure>

---
import type { InstallLine } from '../lib/install';

/**
 * One harness's install commands, copied as a unit. Commands for different
 * harnesses are never mixed into one payload: pasted into the wrong one, they
 * fail. Notes from the README ride beside their line and are never copied.
 */
interface Props {
  label: string;
  lines: InstallLine[];
  class?: string;
}
const { label, lines, class: className = '' } = Astro.props;
const payload = lines.map(l => l.cmd).join('\n');
---

<div class:list={['sheet', className]}>
  <div class="sheet-bar">
    <span>{label}</span>
    <button
      type="button"
      class="copy cursor-pointer rounded-(--radius-guide) border border-line-strong bg-surface-2 px-2 py-0.5 font-sans text-[0.75rem] text-ink transition-colors hover:border-accent hover:text-accent"
      data-copy={payload}
      aria-label={`Copy the ${label} install commands`}>Copy</button
    >
  </div>
  <div class="overflow-x-auto px-4 py-3">
    {
      lines.map(l => (
        <div class="flex items-baseline gap-3 font-mono text-[0.8125rem] leading-[1.8] whitespace-nowrap">
          <code>
            <span class="text-faint select-none" aria-hidden="true">
              {l.cmd.startsWith('/') ? '›' : '$'}{' '}
            </span>
            {l.cmd}
          </code>
          {l.note && <span class="font-sans text-[0.75rem] text-muted">{l.note}</span>}
        </div>
      ))
    }
  </div>
</div>

<script is:inline>
  // One delegated listener for every copy button on the page.
  if (!window.__ideationCopy) {
    window.__ideationCopy = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.copy[data-copy]');
      if (!btn || !navigator.clipboard) return;
      navigator.clipboard.writeText(btn.dataset.copy).then(function () {
        var was = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () {
          btn.textContent = was;
        }, 1400);
      });
    });
  }
</script>

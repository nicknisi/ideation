---
/**
 * A miniature of the contract the planning interview generates.
 *
 * Drawn rather than captured: it re-themes with the page, costs no image
 * request, and cannot go stale as a screenshot would when contract.html's
 * layout moves. It shows the bookmark-garden run, the same invented feature
 * the planning walkthrough follows, so the two pages describe one example.
 */
import Stamp from './Stamp.astro';

const gates = [
  { name: 'problem', evidence: 'the visit log that already exists' },
  { name: 'goals', evidence: 'save → revisit → grow, one loop' },
  { name: 'criteria', evidence: '4 of 6 carry check commands' },
  { name: 'scope', evidence: 'seasons cut, recorded as deferred' },
  { name: 'consistency', evidence: 'schema.ts · bookmarks.visits' },
];

const tiers = [
  { tier: 'Must', items: 'save → seed · visit → growth · wilt query · garden view', dim: false },
  { tier: 'Should', items: 'a configurable wilt window', dim: false },
  { tier: 'Could', items: 'seasons — deferred', dim: true },
];
---

<div class="grid gap-5 p-6 max-[560px]:p-4">
  <div class="flex items-center justify-between gap-4 border-b border-line pb-3">
    <div>
      <p class="flex items-center gap-2 font-sans text-[0.8125rem] text-accent">
        <span class="diamond text-[0.6rem]" aria-hidden="true"></span>Ideation / Contract
      </p>
      <p class="mt-1 text-[1.5rem] leading-tight font-bold">Bookmark garden</p>
      <p class="font-sans text-[0.8125rem] text-muted">express recommended</p>
    </div>
    <Stamp label="Awaiting approval" tone="faint" press class="is-sm mr-1 flex-none" />
  </div>

  <div class="grid gap-6 max-[560px]:gap-4 sm:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
    <div class="grid content-start gap-1.5">
      <p class="font-sans text-[0.8125rem] font-semibold text-muted">Evidence gates · 5 of 5</p>
      {
        gates.map(gate => (
          <p class="flex items-baseline gap-2 text-[0.875rem] leading-[1.5]">
            <span class="font-mono text-go" aria-label="ready">✓</span>
            <span class="w-[6.2rem] flex-none font-mono text-[0.8125rem]">{gate.name}</span>
            <span class="min-w-0 truncate text-muted">{gate.evidence}</span>
          </p>
        ))
      }
    </div>

    <div class="grid content-start gap-1.5 max-[560px]:hidden">
      <p class="font-sans text-[0.8125rem] font-semibold text-muted">Scope tiers</p>
      {
        tiers.map(tier => (
          <p class:list={['text-[0.875rem] leading-[1.5]', tier.dim && 'text-muted']}>
            <span class:list={['mr-2 font-sans text-[0.8125rem] font-semibold', tier.dim ? 'text-muted' : 'text-accent']}>
              {tier.tier}
            </span>
            {tier.items}
          </p>
        ))
      }
    </div>
  </div>

  {/* The phase graph: wave 2 runs its two phases in parallel. */}
  <div class="grid gap-2 border-t border-line pt-4">
    <p class="font-sans text-[0.8125rem] font-semibold text-muted">Phases · 3 waves</p>
    <div class="flex items-center gap-2 font-mono text-[0.75rem]">
      <span class="grid size-8 flex-none place-items-center rounded-(--radius-guide) border border-accent text-accent">01</span>
      <svg class="h-2 w-5 flex-none" viewBox="0 0 20 8" aria-hidden="true" data-ink><path pathLength="1" d="M0 4H20" stroke="var(--line-strong)" stroke-width="1.5" fill="none"></path></svg>
      <span class="grid flex-none gap-1">
        <span class="grid size-8 place-items-center rounded-(--radius-guide) border border-accent text-accent">02</span>
        <span class="grid size-8 place-items-center rounded-(--radius-guide) border border-accent text-accent">03</span>
      </span>
      <svg class="h-2 w-5 flex-none" viewBox="0 0 20 8" aria-hidden="true" data-ink><path pathLength="1" d="M0 4H20" stroke="var(--line-strong)" stroke-width="1.5" fill="none"></path></svg>
      <span class="grid size-8 flex-none place-items-center rounded-(--radius-guide) border border-accent text-accent">04</span>
      <span class="ml-auto truncate font-sans text-[0.8125rem] text-muted max-[560px]:hidden">
        node verify.mjs — 6 checks
      </span>
    </div>
  </div>

</div>

---
import { readVersion } from '../lib/repo';

const version = readVersion();
const REPO = 'https://github.com/nicknisi/ideation';
---

<footer class="mx-auto mt-24 max-w-[76rem] px-[clamp(1.25rem,4vw,2.5rem)] pb-12">
  <div class="rule-double grid gap-6 pt-8 text-[0.9375rem] sm:grid-cols-[minmax(0,1fr)_auto]">
    <div class="grid gap-2">
      <p class="flex items-center gap-2 font-bold">
        <span class="diamond text-[0.8rem]" aria-hidden="true"></span>ideation
      </p>
      <p class="max-w-[52ch] text-muted">
        Agree on the contract, then walk away. MIT licensed, v{version}. Everything it writes is a
        file you own.
      </p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-1.5 font-sans text-[0.875rem] sm:text-right">
      <a class="link" href="/">Overview</a>
      <a class="link" href="/guide/">Guide</a>
      <a class="link" href="/walkthrough/pi/">Pi walkthrough</a>
      <a class="link" href={REPO}>Source ↗</a>
      <a class="link" href="/walkthrough/">Claude Code walkthrough</a>
      <a class="link" href={`${REPO}/releases`}>Releases ↗</a>
    </nav>
  </div>
</footer>

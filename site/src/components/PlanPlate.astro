---
/**
 * A miniature of the plan page a short plan or an interview opens.
 *
 * Drawn rather than captured: it re-themes with the page, costs no image
 * request, and cannot go stale as a screenshot would when plan-render's layout
 * moves. It shows the bookmark-garden plan, the same invented feature the
 * planning walkthrough follows, so the two pages describe one example. What it
 * shows is what plan.json holds: gate evidence, claims with their open
 * decisions and recommended answers, and the units. It carries no approval
 * control, because the page has none: approval is the terminal confirmation.
 */
const gates = [
  { name: 'problem', evidence: 'the visit log that already exists' },
  { name: 'goals', evidence: 'save → revisit → grow, one loop' },
  { name: 'criteria', evidence: '4 of 6 carry check commands' },
  { name: 'scope', evidence: 'seasons cut, recorded as not changing' },
  { name: 'consistency', evidence: 'schema.ts · bookmarks.visits' },
];

const decisions = [
  { claim: '1.2', question: 'Where does the wilt clock live?', answer: 'computed on read', open: false },
  { claim: '1.3', question: 'How long before a seed wilts?', answer: '14 days, configurable', open: true },
];
---

<div class="grid gap-5 p-6 max-[560px]:p-4">
  <div class="flex items-center justify-between gap-4 border-b border-line pb-3">
    <div>
      <p class="flex items-center gap-2 font-sans text-[0.8125rem] text-accent">
        <span class="diamond text-[0.6rem]" aria-hidden="true"></span>Ideation / Plan
      </p>
      <p class="mt-1 text-[1.5rem] leading-tight font-bold">Bookmark garden</p>
      <p class="font-sans text-[0.8125rem] text-muted">interview · plan v2 · supersedes plan.v1.json</p>
    </div>
    <span class="flex-none rounded-(--radius-guide) border border-line px-2 py-1 font-mono text-[0.75rem] text-muted">not approved</span>
  </div>

  <div class="grid gap-6 max-[560px]:gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
    <div class="grid content-start gap-1.5">
      <p class="font-sans text-[0.8125rem] font-semibold text-muted">Evidence gates · 5 of 5</p>
      {
        gates.map(gate => (
          <p class="flex items-baseline gap-2 text-[0.875rem] leading-[1.5]">
            <span class="font-mono text-go" aria-label="ready">✓</span>
            <span class="w-[6.2rem] flex-none font-mono text-[0.8125rem]">{gate.name}</span>
            <span class="min-w-0 truncate text-muted">{gate.evidence}</span>
          </p>
        ))
      }
    </div>

    <div class="grid content-start gap-2 max-[560px]:hidden">
      <p class="font-sans text-[0.8125rem] font-semibold text-muted">Decisions</p>
      {
        decisions.map(d => (
          <div class="grid gap-0.5 text-[0.875rem] leading-[1.45]">
            <p>
              <span class="mr-1.5 font-mono text-[0.75rem] text-muted">[{d.claim}]</span>
              {d.question}
            </p>
            <p class:list={['font-sans text-[0.8125rem]', d.open ? 'text-accent' : 'text-muted']}>
              {d.open ? `Recommended: ${d.answer} · open` : `Answered: ${d.answer}`}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  {/* The unit graph: wave 2 runs its two units in parallel. */}
  <div class="grid gap-2 border-t border-line pt-4">
    <p class="font-sans text-[0.8125rem] font-semibold text-muted">Units · 3 waves</p>
    <div class="flex items-center gap-2 font-mono text-[0.75rem]">
      <span class="grid size-8 flex-none place-items-center rounded-(--radius-guide) border border-accent text-accent">01</span>
      <svg class="h-2 w-5 flex-none" viewBox="0 0 20 8" aria-hidden="true" data-ink><path pathLength="1" d="M0 4H20" stroke="var(--line-strong)" stroke-width="1.5" fill="none"></path></svg>
      <span class="grid flex-none gap-1">
        <span class="grid size-8 place-items-center rounded-(--radius-guide) border border-accent text-accent">02</span>
        <span class="grid size-8 place-items-center rounded-(--radius-guide) border border-accent text-accent">03</span>
      </span>
      <svg class="h-2 w-5 flex-none" viewBox="0 0 20 8" aria-hidden="true" data-ink><path pathLength="1" d="M0 4H20" stroke="var(--line-strong)" stroke-width="1.5" fill="none"></path></svg>
      <span class="grid size-8 flex-none place-items-center rounded-(--radius-guide) border border-accent text-accent">04</span>
      <span class="ml-auto truncate font-sans text-[0.8125rem] text-muted max-[560px]:hidden">
        6 checks · answer on the page, approve in the terminal
      </span>
    </div>
  </div>

</div>

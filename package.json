{
  "name": "ideation",
  "version": "0.23.0",
  "private": true,
  "description": "Whether, then how, then shipped — an evidence-gated interview turns a brain dump into an interactive HTML contract and Markdown specs, and a deterministic workflow engine executes them.",
  "repository": "github:nicknisi/ideation",
  "license": "MIT",
  "author": {
    "name": "Nick Nisi",
    "email": "nick@nisi.org"
  },
  "keywords": [
    "ideation",
    "brainstorming",
    "brain-dump",
    "planning",
    "prd",
    "specification",
    "execution",
    "orchestration",
    "interactive"
  ],
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "pi-subagents": "^0.40.0",
    "@quintinshaw/pi-dynamic-workflows": "^3.5.0",
    "@juicesharp/rpiv-ask-user-question": "^2.3.1"
  },
  "pi": {
    "extensions": [
      "node_modules/pi-subagents/index.ts",
      "node_modules/@quintinshaw/pi-dynamic-workflows/extensions/workflow.ts",
      "node_modules/@juicesharp/rpiv-ask-user-question/index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-subagents/skills",
      "node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
      "node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns"
    ]
  },
  "pi-subagents": {
    "agents": [
      "agents"
    ]
  },
  "scripts": {
    "test": "node scripts/lint-prompts.mjs && node --test 'workflows/*.test.mjs' 'scripts/*.test.mjs' 'test-fixtures/**/*.test.mjs'",
    "lint:prompts": "node scripts/lint-prompts.mjs",
    "dev": "pnpm -C site dev",
    "build": "pnpm -C site build",
    "preview": "pnpm -C site preview",
    "deploy": "pnpm -C site deploy",
    "deploy:check": "pnpm -C site deploy:check",
    "site:install": "pnpm -C site install"
  }
}

{
  "name": "ideation",
  "version": "0.26.1",
  "private": true,
  "description": "Whether, then how, then shipped — an evidence-gated interview turns a brain dump into an interactive HTML contract and Markdown specs, and a deterministic workflow engine executes them.",
  "repository": "github:nicknisi/ideation",
  "license": "MIT",
  "author": {
    "name": "Nick Nisi",
    "email": "nick@nisi.org"
  },
  "keywords": [
    "ideation",
    "brainstorming",
    "brain-dump",
    "planning",
    "prd",
    "specification",
    "execution",
    "orchestration",
    "interactive"
  ],
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "node packages/core/scripts/lint-prompts.mjs && node --test 'packages/core/workflows/*.test.mjs' 'packages/core/scripts/*.test.mjs' 'packages/core/test-fixtures/**/*.test.mjs'",
    "test:mining": "node --test 'packages/core/test-fixtures/mining/*.test.mjs'",
    "test:runrecord": "node --test 'packages/core/scripts/run-report-gen.test.mjs' 'packages/core/test-fixtures/run-report/*.test.mjs'",
    "lint:prompts": "node packages/core/scripts/lint-prompts.mjs",
    "dev": "pnpm -C site dev",
    "build": "pnpm -C site build",
    "preview": "pnpm -C site preview",
    "deploy": "pnpm -C site deploy",
    "deploy:check": "pnpm -C site deploy:check",
    "site:install": "pnpm -C site install"
  }
}

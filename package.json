{
  "name": "ideation",
  "version": "1.0.0",
  "private": true,
  "description": "One /ideation entry point at the right depth (just do it, a short plan, an evidence-gated interview, or a multi-session map), opening with a no-files 'should we?' conversation. It writes a versioned plan you answer on a page or in the terminal, and a deterministic workflow engine runs what you approve in a terminal confirmation.",
  "repository": "github:nicknisi/ideation",
  "license": "MIT",
  "author": {
    "name": "Nick Nisi",
    "email": "nick@nisi.org"
  },
  "keywords": [
    "ideation",
    "planning",
    "brain-dump",
    "interview",
    "plan-review",
    "approval",
    "execution",
    "orchestration",
    "workflow",
    "pi",
    "claude-code"
  ],
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@nicknisi/pi-shared": "^0.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.1",
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "typebox": "*"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "extensions/preflight.ts",
      "extensions/engine.ts",
      "extensions/change.ts"
    ]
  },
  "scripts": {
    "test": "node scripts/lint-prompts.mjs && node --test 'workflows/*.test.mjs' 'scripts/*.test.mjs' 'test-fixtures/**/*.test.mjs'",
    "lint:prompts": "node scripts/lint-prompts.mjs",
    "dev": "pnpm -C site dev",
    "build": "pnpm -C site build",
    "preview": "pnpm -C site preview",
    "deploy": "pnpm -C site deploy",
    "deploy:check": "pnpm -C site deploy:check",
    "site:install": "pnpm -C site install"
  }
}
